                      },
                      "spec": {
                        "dataset": "elemer_tvi",
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "SELECT\n  time_bucket(make_interval(secs => GREATEST(1, ceil($__interval_ms / 10000.0)::int)), \"time\") AS \"time\",\n  avg(temperature) AS \"value\",\n  concat(global_channel, ' - ', sensor_name) AS \"metric\"\nFROM public.sensor_measurements\nWHERE $__timeFilter(\"time\")\n  AND sensor_used = true\n  AND valid = true\n  AND sensor_kind_code = 2\n  AND temperature IS NOT NULL\nGROUP BY 1, global_channel, sensor_name\nORDER BY 1 ASC;",
                        "sql": {
