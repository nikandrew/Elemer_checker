                        "rawQuery": true,
                        "rawSql": "WITH save_graph_2 AS (\n    INSERT INTO public.grafana_variable_state (dashboard_uid, graph_2, updated_at)\n    VALUES ('adk6m4', ${Graph_2}::integer, now())\n    ON CONFLICT (dashboard_uid) DO UPDATE\n    SET graph_2 = EXCLUDED.graph_2, updated_at = now()\n    RETURNING graph_2\n),\nsrc AS (\r\n    SELECT\r\n        \"time\",\r\n        temperature,\r\n        limit_tmin,\r\n        limit_tmax,\r\n        limit_twar,\r\n        limit_tcrit,\r\n        limit_temerg\r\n    FROM public.sensor_measurements\r\n    WHERE\r\n        global_channel = ${Graph_2}\r\n        AND sensor_used = true\r\n        AND valid = true\r\n        AND temperature IS NOT NULL\r\n        AND $__timeFilter(\"time\")\r\n)\r\n\r\nSELECT\r\n    \"time\",\r\n    temperature AS \"value\",\r\n    'temperature' AS \"metric\"\r\nFROM src\r\n\r\nUNION ALL\r\n\r\nSELECT\r\n    \"time\",\r\n    limit_tmin AS \"value\",\r\n    'Tmin' AS \"metric\"\r\nFROM src\r\nWHERE limit_tmin IS NOT NULL\r\n\r\nUNION ALL\r\n\r\nSELECT\r\n    \"time\",\r\n    limit_tmax AS \"value\",\r\n    'Tmax' AS \"metric\"\r\nFROM src\r\nWHERE limit_tmax IS NOT NULL\r\n\r\nUNION ALL\r\n\r\nSELECT\r\n    \"time\",\r\n    limit_twar AS \"value\",\r\n    'Twarn' AS \"metric\"\r\nFROM src\r\nWHERE limit_twar IS NOT NULL\r\n\r\nUNION ALL\r\n\r\nSELECT\r\n    \"time\",\r\n    limit_tcrit AS \"value\",\r\n    'Tcrit' AS \"metric\"\r\nFROM src\r\nWHERE limit_tcrit IS NOT NULL\r\n\r\nUNION ALL\r\n\r\nSELECT\r\n    \"time\",\r\n    limit_temerg AS \"value\",\r\n    'Temerg' AS \"metric\"\r\nFROM src\r\nWHERE limit_temerg IS NOT NULL\r\n\r\n-- Верхняя граница для красной зоны\r\nUNION ALL\r\n\r\nSELECT\r\n    \"time\",\r\n    GREATEST(\r\n        COALESCE(temperature, limit_temerg),\r\n        COALESCE(limit_temerg, temperature)\r\n    ) AS \"value\",\r\n    'Top' AS \"metric\"\r\nFROM src\r\nWHERE limit_temerg IS NOT NULL\r\n\r\n-- Нижняя граница для синей зоны\r\nUNION ALL\r\n\r\nSELECT\r\n    \"time\",\r\n    LEAST(\r\n        COALESCE(temperature, limit_tmin),\r\n        COALESCE(limit_tmin, temperature)\r\n    ) AS \"value\",\r\n    'Bottom' AS \"metric\"\r\nFROM src\r\nWHERE limit_tmin IS NOT NULL\r\n\r\nORDER BY \"time\";",
