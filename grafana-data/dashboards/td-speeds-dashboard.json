                        "format": "time_series",
                        "rawQuery": true,
                        "rawSql": "WITH save_graph AS (\n    INSERT INTO public.grafana_variable_state (dashboard_uid, graph_1, updated_at)\n    VALUES ('td-speeds', ${Graph_1}::integer, now())\n    ON CONFLICT (dashboard_uid) DO UPDATE\n    SET graph_1 = EXCLUDED.graph_1, updated_at = now()\n    RETURNING graph_1\n)\nSELECT\n    sm.\"time\",\n    ROUND(sm.temperature_rate_display::numeric, 3) AS value,\n    'Rate, degC/min' AS metric\nFROM public.sensor_measurements sm\nWHERE sm.global_channel = ${Graph_1}\n  AND sm.sensor_used = true\n  AND sm.valid = true\n  AND sm.sensor_kind_code = 1\n  AND sm.temperature_rate_display IS NOT NULL\n  AND $__timeFilter(sm.\"time\")\nORDER BY sm.\"time\";",
