      "panel-1": {
        "kind": "Panel",
        "spec": {
          "id": 1,
          "title": "Скорости изменения температуры ТД",
          "description": "Скорость берется из поля temperature_rate_display. Знак определяется по короткому окну; отображаемая скорость считается после последней точки разворота.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "postgres",
                      "version": "v0",
                      "datasource": {
                        "name": "elemer-postgres"
                      },
                      "spec": {
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "WITH channels AS (\n  SELECT generate_series(1, 32) AS global_channel\n)\nSELECT\n  concat(ch.global_channel, ' - ', latest.sensor_name) AS \"metric\",\n  ROUND(latest.temperature_rate_display::numeric, 3) AS \"value\"\nFROM channels ch\nJOIN LATERAL (\n  SELECT\n    COALESCE(NULLIF(sm.sensor_name, ''), concat('Sensor ', ch.global_channel)) AS sensor_name,\n    sm.temperature_rate_display\n  FROM public.sensor_measurements sm\n  WHERE sm.global_channel = ch.global_channel\n    AND sm.sensor_used = true\n    AND sm.valid = true\n    AND sm.sensor_kind_code = 1\n    AND sm.temperature_rate_display IS NOT NULL\n    AND $__timeFilter(sm.\"time\")\n  ORDER BY sm.\"time\" DESC\n  LIMIT 1\n) latest ON true\nORDER BY ch.global_channel;",
                        "sql": {
                          "columns": [
                            {
                              "parameters": [],
                              "type": "function"
                            }
                          ],
                          "groupBy": [
                            {
                              "property": {
                                "type": "string"
                              },
                              "type": "groupBy"
                            }
                          ],
                          "limit": 50
                        }
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [
                {
                  "kind": "Transformation",
                  "group": "rowsToFields",
                  "spec": {
                    "options": {
                      "mappings": [
                        {
