                                                                                                                                                     "rawQuery":  true,
                                                                                                                                                     "rawSql":  "WITH src AS (\r\n    SELECT\r\n        \"time\",\r\n        temperature,\r\n        limit_tmin,\r\n        limit_tmax,\r\n        limit_twar,\r\n        limit_tcrit,\r\n        limit_temerg\r\n    FROM public.sensor_measurements\r\n    WHERE\r\n        global_channel = ${Graph_1}\r\n        AND sensor_used = true\r\n        AND valid = true\r\n        AND temperature IS NOT NULL\r\n        AND $__timeFilter(\"time\")\r\n)\r\n\r\nSELECT\r\n    \"time\",\r\n    temperature AS \"value\",\r\n    \u0027temperature\u0027 AS \"metric\"\r\nFROM src\r\n\r\nUNION ALL\r\n\r\nSELECT\r\n    \"time\",\r\n    limit_tmin AS \"value\",\r\n    \u0027Tmin\u0027 AS \"metric\"\r\nFROM src\r\nWHERE limit_tmin IS NOT NULL\r\n\r\nUNION ALL\r\n\r\nSELECT\r\n    \"time\",\r\n    limit_tmax AS \"value\",\r\n    \u0027Tmax\u0027 AS \"metric\"\r\nFROM src\r\nWHERE limit_tmax IS NOT NULL\r\n\r\nUNION ALL\r\n\r\nSELECT\r\n    \"time\",\r\n    limit_twar AS \"value\",\r\n    \u0027Twarn\u0027 AS \"metric\"\r\nFROM src\r\nWHERE limit_twar IS NOT NULL\r\n\r\nUNION ALL\r\n\r\nSELECT\r\n    \"time\",\r\n    limit_tcrit AS \"value\",\r\n    \u0027Tcrit\u0027 AS \"metric\"\r\nFROM src\r\nWHERE limit_tcrit IS NOT NULL\r\n\r\nUNION ALL\r\n\r\nSELECT\r\n    \"time\",\r\n    limit_temerg AS \"value\",\r\n    \u0027Temerg\u0027 AS \"metric\"\r\nFROM src\r\nWHERE limit_temerg IS NOT NULL\r\n\r\n-- Верхняя граница для красной зоны\r\nUNION ALL\r\n\r\nSELECT\r\n    \"time\",\r\n    GREATEST(\r\n        COALESCE(temperature, limit_temerg),\r\n        COALESCE(limit_temerg, temperature)\r\n    ) AS \"value\",\r\n    \u0027Top\u0027 AS \"metric\"\r\nFROM src\r\nWHERE limit_temerg IS NOT NULL\r\n\r\n-- Нижняя граница для синей зоны\r\nUNION ALL\r\n\r\nSELECT\r\n    \"time\",\r\n    LEAST(\r\n        COALESCE(temperature, limit_tmin),\r\n        COALESCE(limit_tmin, temperature)\r\n    ) AS \"value\",\r\n    \u0027Bottom\u0027 AS \"metric\"\r\nFROM src\r\nWHERE limit_tmin IS NOT NULL\r\n\r\nORDER BY \"time\";",
